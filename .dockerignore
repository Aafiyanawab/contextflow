# Keep the build context small and secrets/dev-cruft out of the image.
.git/
.gitignore
.gitattributes
__pycache__/
*.pyc
*.pyo
*.pyd

# Secrets & local config — injected at runtime via env, never baked in.
.env
.env.*
!.env.example

# Virtualenvs
venv/
.venv/

# Local dev database & uploaded files (ephemeral; not part of the image)
instance/
*.db
*.sqlite3

# Infra & deploy manifests — provision/deploy the app, never run inside it.
# Excluding terraform/ also keeps its local .terraform/ provider plugins (large
# Go binaries that carry their own CVEs) out of the image; they are gitignored
# so CI never sees them, but a local `docker build` would otherwise bake them in.
terraform/
k8s-aws/
monitoring/

# Docs / CI / editor noise not needed at runtime
docs/
.github/
*.md
.DS_Store
.vscode/
.idea/
